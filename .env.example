# 자격증명 모음. 이 파일을 `.env` 로 복사해 값을 채운다.
# `.env` 는 .gitignore 에 있어 저장소에 올라가지 않는다.
#
#   cp .env.example .env
#
# 찾는 순서: 환경변수 → .env → .secrets.toml(옛 방식)
# 이미 .secrets.toml 을 쓰고 있다면 그대로 둬도 되고, .env 로 옮겨도 된다.


# ── 자료조사: 한국 웹 검색 (scripts/search_kr.py) ─────────────────────────
# 없으면 정책브리핑(korea.kr)만 검색된다. "못 돌림"이지 "자료 없음"이 아니므로
# 조사 보고서에 그렇게 적힌다.

# 네이버 검색 API — NAVER API HUB(네이버 클라우드 플랫폼)에서 발급.
# 개발자센터는 2026-07-31 부터 신규 신청이 막혔다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# HUB 로 옮기면 요청 주소와 헤더 이름이 바뀐다. 그때만 아래 3개를 채운다.
# 비워 두면 옛 openapi.naver.com 기준 기본값을 쓴다.
NAVER_API_BASE=
NAVER_ID_HEADER=
NAVER_SECRET_HEADER=

# 카카오(다음) 검색 API — developers.kakao.com → 앱 → REST API 키 (무료)
KAKAO_REST_KEY=


# ── 네이버 블로그 / 데이지 어드민 로그인 ──────────────────────────────────
# 비밀번호는 여기에 적지 않는다. 적을 자리도 두지 않았다.
#
# 로그인은 사람이 한 번 하고, 그 브라우저 프로필을 재사용한다.
#   uv run prpub naver-login    → .naver-profile/ 에 남는다
#   uv run prpub site-login     → .daeasy-session.json 에 남는다
#
# 자동 로그인을 시도하면 네이버가 기계로 보고 계정 보호조치를 건다.
# 실제로 전에 그렇게 막혔다 (prpub/naver.py 의 session_context 주석 참고).
